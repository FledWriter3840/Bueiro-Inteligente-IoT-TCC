# =================================================================
# Configurações do Bueiro Inteligente API
# =================================================================

# Banco de Dados MySQL
DATABASE_URL=mysql+pymysql://root:1234@localhost:3306/bueiro_inteligente

# API OpenWeatherMap (obtenha gratuitamente em https://openweathermap.org/api)
OPENWEATHER_API_KEY=
OPENWEATHER_CACHE_TTL=600

# Localização geográfica padrão do bueiro (Latitude / Longitude)
BUEIRO_LATITUDE=-23.5505
BUEIRO_LONGITUDE=-46.6333

# Caminhos para datasets externos (preencher quando os arquivos existirem)
# Exemplo CSV alagamentos: CGE SP / Defesa Civil
DADOS_ALAGAMENTOS_PATH=

# Exemplo CSV ou GeoJSON topográfico: GeoSampa
DADOS_GEOGRAFICOS_PATH=

# Exemplo JSON de configuração de uso do solo / entorno
DADOS_USO_SOLO_PATH=
