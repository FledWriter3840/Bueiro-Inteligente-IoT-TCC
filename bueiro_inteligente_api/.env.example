# Use DATABASE_URL ou informe as variáveis MYSQL_* abaixo.
DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bueiro_inteligente

# Serviços externos opcionais.
OPENWEATHER_API_KEY=
OPENWEATHER_CACHE_TTL=60
OPENTOPOGRAPHY_API_KEY=
OPENTOPOGRAPHY_DATASET=COP30

# Coordenadas padrão e escala indicativa do sensor ultrassônico.
BUEIRO_LATITUDE=-23.5505
BUEIRO_LONGITUDE=-46.6333
BUEIRO_PROFUNDIDADE_CM=450

# Datasets externos opcionais.
DADOS_ALAGAMENTOS_PATH=
DADOS_GEOGRAFICOS_PATH=
DADOS_USO_SOLO_PATH=
CEMADEN_ESTACAO=

# OpenStreetMap / Overpass.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_API_URL_FALLBACK=https://overpass.kumi.systems/api/interpreter
OVERPASS_RAIO_METROS=500

# Armazenamento de fotos de denúncias.
UPLOADS_DIR=
